# Copier en terraform.tfvars (jamais versionné : exclu par .gitignore), puis compléter.
# Terraform le lit tout seul, en plus de -var-file=prod.tfvars.

subscription_id = "az account show --query id -o tsv"
email_alerte    = "vous@example.org"
